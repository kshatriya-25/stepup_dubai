# dependencies
node_modules
.pnp
.pnp.js

# build output
#
# `out/` is the static export produced by `next build` (output:'export'). It's
# disposable and duplicates public/ — never track it. The server rebuilds it and
# rsyncs it to /var/www/tier2expo/expo-public (see HOSTING.md).
.next
out
build
dist

# typescript / next caches
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# SECRETS
# ---------------------------------------------------------------------------
# EVERY .env variant, not just .env and .env.local. These files hold SMTP_PASS,
# RAZORPAY_KEY_SECRET and DATABASE_URL, and the deployment guides describe keeping
# separate ones for production and staging — so .env.production and .env.staging
# are exactly the names somebody will reach for. They used to be committable.
#
# Nothing is ever delivered by git: every .env is created on the box by hand.
# See HOSTING.md Step 2 and deploy/STAGING.md Step 4.
.env
.env.*
# An example file carries no real values and is the one worth sharing, if ever added.
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / os
.DS_Store
.idea
.vscode
*.swp
Thumbs.db

# NOTE: public/ IS tracked on purpose — logos, posters, happens images and
# video/hero.mp4 are required at build time, so the server must receive them
# from git.

# ---------------------------------------------------------------------------
# CUSTOMER DATA — none of this may ever be committed.
# ---------------------------------------------------------------------------

# The lead log and the payment journal live here: data/leads.jsonl holds every
# free-pass and waitlist submission, data/payments.jsonl every paid one. Both are
# the RECORD the site falls back on, and both are full of names, emails, phone
# numbers and pitch text.
data/

# Database dumps. The registrations table is the same data again, and `pg_dump >
# backup.sql` in the repo root is the easy way to commit all of it at once. The
# schema in db/*.sql IS tracked on purpose — that is structure, not data — so
# these patterns are deliberately narrow enough not to catch it.
*.dump
*.sql.gz
*.sql.bz2
*.sql.zip
backup*.sql
dump*.sql
pg_dump*.sql
*.backup

# Anything exported for a spreadsheet or a mail merge.
*.csv
!public/**/*.csv
